# Copy to .env for local development. Placeholders only — never commit real secrets.

APP_NAME=cyber-deception-ai
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api

# --- CORS ---
# Local development (Vite dev server):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: set the deployed frontend origin. When ENVIRONMENT=production these
# replace the local defaults instead of adding to them. No trailing slash.
# ALLOWED_ORIGINS=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app

# --- Database ---
# Local default, no PostgreSQL required:
DATABASE_URL=sqlite:///./cyber_deception.db
# Docker Compose supplies a PostgreSQL URL automatically.
# Managed PostgreSQL (Render / Railway / Neon) — paste the provider's URL as-is;
# a `postgres://` or `postgresql://` scheme is rewritten to psycopg automatically:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Server ---
# Render and Railway inject PORT; this is only a local fallback.
# PORT=8000
