# Copy to .env for local development. Only public VITE_* values belong here —
# never put secrets in frontend environment variables; they ship in the bundle.

# Local development: leave empty so the Vite dev proxy forwards /api.
VITE_API_BASE_URL=

# Production (Vercel): set this to the deployed backend origin, no trailing slash.
# VITE_API_BASE_URL=https://your-api.onrender.com

# Where the dev proxy forwards /api. Use http://backend:8000 under Docker Compose.
VITE_PROXY_TARGET=http://localhost:8000
